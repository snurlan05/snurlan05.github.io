<BaseLayout>
<nav class="chapter-rail" aria-label="Journey chapters"><ol><li><a data-chapter-link href="#overview" aria-label="Overview"><span class="rail-label">Overview</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#entry" aria-label="Enter the brain"><span class="rail-label">Enter the brain</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#experience-healthcare" aria-label="Healthcare experience"><span class="rail-label">Healthcare experience</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#experience-robotics" aria-label="Robotics experience"><span class="rail-label">Robotics experience</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#experience-teaching" aria-label="Teaching experience"><span class="rail-label">Teaching experience</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#project-formulation" aria-label="Form-ulation project"><span class="rail-label">Form-ulation project</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#project-payguard" aria-label="PayGuard project"><span class="rail-label">PayGuard project</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#project-uncrania" aria-label="UNCrania project"><span class="rail-label">UNCrania project</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#project-breezability" aria-label="Breezability project"><span class="rail-label">Breezability project</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#skills" aria-label="Skills and education"><span class="rail-label">Skills and education</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#certifications" aria-label="Certifications"><span class="rail-label">Certifications</span><span class="rail-dot" aria-hidden="true"></span></a></li><li><a data-chapter-link href="#contact" aria-label="Contact"><span class="rail-label">Contact</span><span class="rail-dot" aria-hidden="true"></span></a></li></ol></nav>
<main id="main-content"><section id="overview" class="story-section overview-section" data-chapter="overview" aria-labelledby="overview-heading"><div class="chapter-content hero-content"><h1 id="overview-heading" tabindex="-1"><span>Samgar</span><span>Nurlan</span></h1><p class="hero-role">Software engineering student<br><span>University of Waterloo</span></p><div class="hero-links"><a class="primary-link" href="#project-formulation">Explore my work <svg viewBox="0 0 20 20" fill="none" width="20" height="20" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a class="text-link" href="/samgar-nurlan-resume.pdf" download>Download résumé <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M10 3v9m-3-3 3 3 3-3M4 14v3h12v-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div id="brain-stage" aria-hidden="true"><picture><source media="(max-width: 600px)" srcset="/images/brain-poster-mobile.webp" width="960" height="840"><img id="brain-poster" src="/images/brain-hero.webp" alt="" width="1600" height="1400" fetchpriority="high"></picture><canvas id="brain-canvas" aria-hidden="true"></canvas><div class="scene-shade"></div></div><a class="scroll-cue" href="#entry"><span>Scroll to explore</span><svg viewBox="0 0 18 28" width="18" height="28" fill="none" aria-hidden="true"><path d="M9 1v24m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></section><section id="entry" class="story-section entry-section" data-chapter="entry" aria-labelledby="entry-heading"><div class="chapter-content"><div class="content-copy entry-copy"><h2 id="entry-heading" tabindex="-1">Follow the<br>connections.</h2><p class="section-summary">Experience, projects, and the ideas connecting them.</p><a class="text-link" href="#experience-healthcare">Start with experience <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></section><section id="experience-healthcare" class="story-section experience-section" data-chapter="experience-healthcare" aria-labelledby="experience-healthcare-heading"><div class="chapter-content"><div class="content-copy"><h2 id="experience-healthcare-heading" tabindex="-1">The J Healthcare Initiative</h2><div class="role-line"><p>Software Developer</p><p>June–September 2026</p></div><p class="location">Waterloo, Ontario</p><p class="section-summary">Built a centralized data-management prototype for a nonprofit’s funding, program, and operational information, as part of a six-person development team.</p><ul class="contribution-list"><li>Translated stakeholder feedback into technical requirements.</li><li>Helped design database and intake-form components from those requirements.</li><li>Developed and updated the Azure SQL structure and supported integration with the .NET backend and data-intake workflow.</li><li>Contributed to testing, deployment, and technical documentation.</li></ul><ol class="project-workflow" aria-label="The J Healthcare Initiative workflow"><li><span class="workflow-node" aria-hidden="true"></span><span>Intake</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Database</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Operations</span></li></ol><ul class="technology-list" aria-label="Technologies and disciplines"><li>C#</li><li>.NET</li><li>Azure SQL</li><li>Microsoft Azure</li><li>REST APIs</li></ul><p class="project-note">Delivered as a functional prototype for future organizational use.</p><a class="text-link section-link" href="https://github.com/J15A/team-839-repo" target="_blank" rel="noopener noreferrer">View source on GitHub <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="visually-hidden"> (opens in a new tab)</span></a></div></div></section><section id="experience-robotics" class="story-section experience-section" data-chapter="experience-robotics" aria-labelledby="experience-robotics-heading"><div class="chapter-content"><div class="content-copy"><h2 id="experience-robotics-heading" tabindex="-1">UWaterloo Robotics Team</h2><div class="role-line"><p>Software Developer</p><p>2025–Present</p></div><p class="location">Waterloo, Ontario</p><p class="section-summary">Making robot teleoperation more usable, from the keys an operator presses to the velocity commands a robot receives.</p><ul class="contribution-list"><li>Implemented WASD controls by modifying ROS2 teleop twist keyboard nodes.</li><li>Added real-time linear and angular velocity tuning, and validated command publishing with ROS2 debugging tools on Linux.</li></ul><ul class="technology-list" aria-label="Technologies and disciplines"><li>ROS2</li><li>Linux</li><li>Robot teleoperation</li></ul></div></div></section><section id="experience-teaching" class="story-section experience-section" data-chapter="experience-teaching" aria-labelledby="experience-teaching-heading"><div class="chapter-content"><div class="content-copy"><h2 id="experience-teaching-heading" tabindex="-1">ACM @ CCNY</h2><div class="role-line"><p>Technical Workshop Lead</p><p>2023–2025</p></div><p class="location">New York City, New York</p><p class="section-summary">Helping students turn curiosity into practical programming skills.</p><ul class="contribution-list"><li>Designed and delivered workshops for 20+ students on Python, data structures and algorithms, and web development.</li><li>Coordinated guest talks with alumni engineers to connect classroom learning with software development practice.</li></ul><ul class="technology-list" aria-label="Technologies and disciplines"><li>Python</li><li>Data structures</li><li>Algorithms</li><li>Web development</li></ul></div></div></section><section id="project-formulation" class="story-section project-section" data-chapter="project-formulation" aria-labelledby="project-formulation-heading"><div class="chapter-content"><div class="content-copy"><h2 id="project-formulation-heading" tabindex="-1">Form-ulation</h2><p class="project-description">AI bicep curl form analyzer</p><p class="section-summary">A computer vision system that turns webcam movement into real-time feedback on bicep curl form.</p><ul class="contribution-list"><li>Built a pipeline from YOLOv8 pose estimation through biomechanical feature engineering to classification.</li><li>Implemented webcam inference with OpenCV and a Streamlit interface for feedback and confidence scores.</li></ul><ol class="project-workflow" aria-label="Form-ulation workflow"><li><span class="workflow-node" aria-hidden="true"></span><span>Pose</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Features</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Feedback</span></li></ol><ul class="technology-list" aria-label="Technologies"><li>Python</li><li>YOLOv8</li><li>OpenCV</li><li>Streamlit</li><li>React</li><li>Vite</li><li>Snowflake</li></ul><a class="text-link section-link" href="https://github.com/snurlan05/form-ulation" target="_blank" rel="noopener noreferrer">View source on GitHub <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="visually-hidden"> (opens in a new tab)</span></a><p class="project-note">The YOLOv8 + Random Forest model was trained on one subject and setup; a working build does not prove reliable performance on unseen users — see the repo for the honest limitations.</p></div></div></section><section id="project-payguard" class="story-section project-section" data-chapter="project-payguard" aria-labelledby="project-payguard-heading"><div class="chapter-content"><div class="content-copy"><h2 id="project-payguard-heading" tabindex="-1">PayGuard</h2><p class="project-description">Invoice review and fraud-risk screening</p><p class="section-summary">A standalone demo that flags potentially suspicious invoices and transactions for review before payment.</p><ul class="contribution-list"><li>Built a deterministic, rule-based checker for unusual amounts, bank-account changes, urgent payment requests, and vendor inconsistencies.</li><li>Implemented risk scoring and approval workflows to help businesses review high-risk payments.</li></ul><ol class="project-workflow" aria-label="PayGuard workflow"><li><span class="workflow-node" aria-hidden="true"></span><span>Invoice</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Risk signals</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Review</span></li></ol><ul class="technology-list" aria-label="Technologies"><li>React</li><li>JavaScript</li><li>Vite</li><li>Tailwind CSS</li></ul><a class="text-link section-link" href="https://github.com/snurlan05/payguard-fraud-detection" target="_blank" rel="noopener noreferrer">View source on GitHub <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="visually-hidden"> (opens in a new tab)</span></a><p class="project-note">Reconstructed standalone demo of the original Base44 prototype. Scoring is fixed rules, not a live model; invoice upload records metadata only, and the explanations are rule-generated text. Simulation only — it never moves money or connects to a bank.</p></div></div></section><section id="project-uncrania" class="story-section project-section" data-chapter="project-uncrania" aria-labelledby="project-uncrania-heading"><div class="chapter-content"><div class="content-copy"><h2 id="project-uncrania-heading" tabindex="-1">UNCrania</h2><p class="project-description">Project management tool — Kanban board and team chat</p><p class="section-summary">A team project-management tool with a Kanban board, task tracking, and built-in team chat.</p><ul class="contribution-list"><li>Built the React and Vite frontend with a Kanban board for tracking work across a team.</li><li>Implemented a Flask REST API backed by SQLite, with bcrypt passwords and 24-hour JWT sessions with role-based access.</li><li>Added team chat so discussion stays with the work it belongs to.</li></ul><ol class="project-workflow" aria-label="UNCrania workflow"><li><span class="workflow-node" aria-hidden="true"></span><span>Board</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Tasks</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Chat</span></li></ol><ul class="technology-list" aria-label="Technologies"><li>React</li><li>Vite</li><li>Flask</li><li>SQLite</li><li>bcrypt</li><li>PyJWT</li></ul><p class="project-note">Built with collaborators; source lives on GitLab.</p><a class="text-link section-link" href="https://gitlab.com/reni-boys/Project_Management" target="_blank" rel="noopener noreferrer">View source on GitLab <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="visually-hidden"> (opens in a new tab)</span></a></div></div></section><section id="project-breezability" class="story-section project-section" data-chapter="project-breezability" aria-labelledby="project-breezability-heading"><div class="chapter-content"><div class="content-copy"><h2 id="project-breezability-heading" tabindex="-1">Breezability</h2><p class="project-description">Smart window opener — Arduino, FastAPI, and a live dashboard</p><p class="section-summary">A smart window opener that reads temperature and light, drives a servo, and reports everything to a live dashboard.</p><ul class="contribution-list"><li>Wired an Arduino with a servo, temperature and light sensors, and an LCD to open and close a window by itself.</li><li>Built a FastAPI backend that reads the sensors over serial and serves live data and a target-temperature control.</li><li>Built a Next.js dashboard showing temperature, light, and servo position, with a mock-data mode for demoing without hardware.</li></ul><ol class="project-workflow" aria-label="Breezability workflow"><li><span class="workflow-node" aria-hidden="true"></span><span>Sense</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Decide</span><svg viewBox="0 0 40 12" fill="none" aria-hidden="true"><path d="M1 6h37m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg></li><li><span class="workflow-node" aria-hidden="true"></span><span>Act</span></li></ol><ul class="technology-list" aria-label="Technologies"><li>TypeScript</li><li>Next.js</li><li>FastAPI</li><li>Python</li><li>Arduino</li></ul><p class="project-note">The dashboard started from a generated Next.js template; the Arduino sketch, serial reader, FastAPI backend, and control logic are the original work.</p><a class="text-link section-link" href="https://github.com/snurlan05/Breezability" target="_blank" rel="noopener noreferrer">View source on GitHub <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="visually-hidden"> (opens in a new tab)</span></a></div></div></section><section id="skills" class="story-section skills-section" data-chapter="skills" aria-labelledby="skills-heading"><div class="chapter-content"><div class="content-copy"><h2 id="skills-heading" tabindex="-1">A working toolkit.</h2><dl class="skills-list"><div><dt>Languages</dt><dd>Python, C, C++, C#, SQL, Java, Verilog</dd></div><div><dt>Frameworks &amp; web</dt><dd>React, Vite, Flask, .NET, REST APIs, Streamlit, YOLOv8</dd></div><div><dt>Databases</dt><dd>MySQL, SQLite, Snowflake, Azure SQL</dd></div><div><dt>Libraries &amp; tools</dt><dd>Azure, OpenCV, bcrypt, PyJWT, Git/GitHub, GitLab, Docker, ROS2</dd></div></dl><div class="education"><h3>University of Waterloo</h3><p>Candidate for a Bachelor of Software Engineering</p><p class="education-date">2025–2030 <span>Waterloo, Ontario</span></p></div></div></div></section><section id="certifications" class="story-section" data-chapter="certifications" aria-labelledby="certifications-heading"><div class="chapter-content"><div class="content-copy"><h2 id="certifications-heading" tabindex="-1">Certified on Azure.</h2><p class="section-summary">Two Microsoft fundamentals certifications, earned in June 2026.</p></div><div class="cert-grid">{certifications.map((cert) => <CertCard cert={cert} />)}</div><p><a class="text-link section-link" href="/certifications">View certifications <svg viewBox="0 0 20 20" fill="none" width="18" height="18" aria-hidden="true"><path d="M10 4v12m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></p></div></section><section id="contact" class="story-section contact-section" data-chapter="contact" aria-labelledby="contact-heading"><div class="chapter-content"><div class="content-copy contact-copy"><h2 id="contact-heading" tabindex="-1">Start a<br>conversation.</h2><p class="section-summary">Have a project in mind, or want to talk about my work? I’d like to hear from you.</p><a class="contact-email" href="mailto:nurlansamgar5@gmail.com">nurlansamgar5@gmail.com</a><div class="contact-links"><a class="text-link" href="https://github.com/snurlan05" target="_blank" rel="noopener noreferrer">GitHub <span class="visually-hidden">(opens in a new tab)</span></a><a class="text-link" href="https://www.linkedin.com/in/snurlan/" target="_blank" rel="noopener noreferrer">LinkedIn <span class="visually-hidden">(opens in a new tab)</span></a><a class="text-link" href="/samgar-nurlan-resume.pdf" download>Download résumé</a></div></div></div></section></main>
<script src="../scripts/main.ts"></script>
</BaseLayout>
