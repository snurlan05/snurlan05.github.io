---
// Certification card. No Microsoft badge artwork is used: no official badge
// graphic is available locally, so the card is clean text + a generic shield
// mark drawn in the site's own icon style. Credential IDs are never shown.
import type { Certification } from "../data/certifications";

interface Props {
  cert: Certification;
}
const { cert } = Astro.props;
---

<article class="cert-card">
  <div class="cert-card-top">
    <svg
      class="cert-shield"
      viewBox="0 0 24 24"
      width="34"
      height="34"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M12 2.5 20 5.5v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10v-6l8-3Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"></path>
      <path
        d="m8.5 12 2.4 2.4L15.7 9.5"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <div>
      <h3>{cert.title}</h3>
      <p class="cert-issuer">
        {cert.issuer} · Exam {cert.examCode}
      </p>
    </div>
  </div>
  <p class="cert-covers">{cert.covers}</p>
  <ul class="cert-skills" aria-label="Topics covered">
    {cert.skills.map((skill) => <li>{skill}</li>)}
  </ul>
  <p class="cert-date">
    Issued <time>{cert.issued}</time>
  </p>
</article>
